<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- La app no necesita conexión: todo se sirve desde sus activos. El permiso existe porque la WebView carga
         esos activos por una URL https interceptada (appassets.androidplatform.net); sin él, la WebView puede
         bloquear esas cargas. Pendiente comprobar en un teléfono si se puede retirar. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <!-- Solo vertical. adjustResize: con el teclado abierto la WebView se encoge y las barras del editor
             quedan justo encima de él (MainActivity aplica los márgenes del teclado). -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
